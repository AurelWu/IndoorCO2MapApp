<?xml version="1.0" encoding="utf-8" ?>
<local:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:local="clr-namespace:IndoorCO2MapAppV2.Pages"
               xmlns:t="clr-namespace:IndoorCO2MapAppV2.Resources.Strings"
               xmlns:controls="clr-namespace:IndoorCO2MapAppV2.Controls"
               xmlns:enums="clr-namespace:IndoorCO2MapAppV2.Enumerations"
               xmlns:ui="clr-namespace:IndoorCO2MapAppV2.UIUtility"
               x:Class="IndoorCO2MapAppV2.Pages.TransitMeasurementPage"
               Title="Transit Measurement">

    <local:AppPage.Resources>
        <ResourceDictionary>
            <ui:LocationDisplayConverter x:Key="LocationDisplayConverter" />
            <ui:TransitRouteDisplayConverter x:Key="TransitRouteDisplayConverter" />
        </ResourceDictionary>
    </local:AppPage.Resources>

    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="25">

    <Label x:Name="MeasuredLocationLabel" Text="{x:Static t:Localisation.TransitRouteStationPlaceholder}"
           Style="{StaticResource PageTitleStyle}"/>

    <HorizontalStackLayout HorizontalOptions="End" Margin="0,-5,0,-15" Spacing="8" VerticalOptions="Center">
        <VerticalStackLayout Spacing="2">
            <Label x:Name="SensorInfoLabel"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="End" />
            <Label x:Name="NextUpdateLabel"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                   HorizontalOptions="End" />
        </VerticalStackLayout>
        <Button x:Name="InstantUpdateButton"
                Text="↺"
                FontSize="16"
                Clicked="OnInstantUpdateClicked"
                Style="{StaticResource SecondaryButtonStyle}"
                WidthRequest="40"
                HeightRequest="40"
                Padding="0"
                VerticalOptions="Center" />
    </HorizontalStackLayout>

    <!-- Chart + slider share the grid area. Slider spans both rows so its
         transparent hit-extensions cover the full chart height. Chart sits
         on top visually (added last = higher z-order) but is InputTransparent
         so touches fall through to the slider's extended hit areas. -->
    <Grid RowDefinitions="150, 55">
        <controls:RangeSlider
            x:Name="TrimSlider"
            Grid.Row="0"
            Grid.RowSpan="2"
            RangeChanged="OnTrimChanged"
            Minimum="0"
            Maximum="20"
            LowerValue="0"
            UpperValue="20"
            ThumbSize="30"
            TrackHeight="15"
            TrackColor="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
            HighlightColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            WidthRequest="375" />
        <controls:LineChartView x:Name="lineChartView"
                                Grid.Row="0"
                                HeightRequest="150"
                                WidthRequest="400"
                                InputTransparent="True" />
    </Grid>

        <!-- Change Transit Line -->
        <Border x:Name="ChangeRouteCard" Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">

                <!-- Header row: current route label + expand toggle -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="Transit Line" Style="{StaticResource SectionLabelStyle}" />
                        <Label x:Name="CurrentRouteLabel" FontSize="13" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1"
                            x:Name="ChangeRouteToggleButton"
                            Text="▼"
                            Clicked="OnChangeRouteToggleClicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HeightRequest="36" Padding="10,0"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Expandable content (collapsed by default) -->
                <VerticalStackLayout x:Name="ChangeRouteSection" IsVisible="False" Spacing="8">

                    <!-- Search button + spinner -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button x:Name="RouteSearchButton" Grid.Column="0"
                                Text="Search routes near me"
                                Clicked="OnSearchRoutesClicked"
                                HorizontalOptions="Fill" />
                        <ActivityIndicator x:Name="RouteSearchIndicator" Grid.Column="1"
                                           IsVisible="False" IsRunning="False"
                                           WidthRequest="24" HeightRequest="24"
                                           VerticalOptions="Center" />
                    </Grid>

                    <!-- Mode filter -->
                    <controls:LabeledSegmentedControl x:Name="RouteModeFilter"
                        Label="" FillWidth="True" MaxItemsPerRow="3" />

                    <!-- Route picker + favourite star -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" HorizontalOptions="Fill">
                        <Border Grid.Column="0"
                                Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                                StrokeThickness="{OnPlatform iOS=2, Android=0}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                            <Picker x:Name="ChangeRoutePicker"
                                    ItemDisplayBinding="{Binding Converter={StaticResource TransitRouteDisplayConverter}}"
                                    SelectedIndexChanged="OnChangeRoutePickerChanged"
                                    Title="Select route..." />
                        </Border>
                        <Label x:Name="ChangeRouteStarLabel"
                               Grid.Column="1" Text="★" FontSize="30"
                               TextColor="#BDBDBD" VerticalOptions="Center" Margin="8,0,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangeRouteStarTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Route text filter -->
                    <Entry x:Name="RouteFilterEntry"
                           Placeholder="{x:Static t:Localisation.TransitSearchRoutesByName}"
                           TextChanged="OnRouteFilterTextChanged" />

                    <!-- Route preview map -->
                    <ActivityIndicator x:Name="RoutePreviewLoadingIndicator"
                                       IsVisible="False" IsRunning="False"
                                       HorizontalOptions="Center" />
                    <Border x:Name="RoutePreviewBorder"
                            IsVisible="False" HeightRequest="200"
                            Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                            StrokeThickness="1">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <controls:MapContainerView x:Name="ChangeRoutePreviewContainer" />
                    </Border>

                    <!-- Confirm button -->
                    <Button x:Name="ConfirmRouteButton"
                            Text="Apply Route Change"
                            Clicked="OnConfirmRouteChangeClicked"
                            HorizontalOptions="Fill" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Destination (optional) -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.TransitDestinationLabel}" Style="{StaticResource SectionLabelStyle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0" x:Name="SearchEndpointButton"
                            Text="{x:Static t:Localisation.TransitSearchNearbyStops}"
                            Clicked="OnSearchEndpointClicked"
                            HorizontalOptions="Fill" />
                    <Button Grid.Column="1" x:Name="LoadEndpointCacheButton"
                            Text="📁"
                            FontSize="20"
                            Clicked="OnLoadEndpointCacheClicked"
                            HorizontalOptions="Fill" />
                </Grid>
                <ActivityIndicator x:Name="EndpointSearchIndicator"
                                   IsVisible="False" IsRunning="False"
                                   HorizontalOptions="Center" />
                <Label x:Name="EndpointStatusLabel"
                       IsVisible="False"
                       FontSize="13" TextColor="Gray"
                       HorizontalOptions="Center" />
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center" HorizontalOptions="Fill">
                    <Border Grid.Column="0"
                            x:Name="EndpointPickerBorder"
                            Stroke="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource DividerColorDark}}"
                            StrokeThickness="{OnPlatform iOS=2, Android=0}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="4"/></Border.StrokeShape>
                        <Picker x:Name="EndpointPicker"
                                ItemDisplayBinding="{Binding Converter={StaticResource LocationDisplayConverter}, ConverterParameter='(no destination)'}"
                                SelectedIndexChanged="OnEndpointPickerSelectionChanged"
                                Title="{x:Static t:Localisation.TransitSelectDestination}" />
                    </Border>
                    <Label x:Name="EndpointStarLabel"
                           Grid.Column="1"
                           Text="★"
                           TextColor="#BDBDBD"
                           FontSize="30"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           Margin="8,0,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnEndpointStarTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="12">

                <!-- Windows open? -->
                <Label Text="{x:Static t:Localisation.RadioButtonLabelOpenDoorsWindows}"
                       Style="{StaticResource SectionLabelStyle}" />

                <HorizontalStackLayout Spacing="5">
                    <RadioButton
                        x:Name="WindowsUnknownRb"
                        Content="{x:Static t:Localisation.RadioNoData}"
                        IsChecked="True"
                        GroupName="TransitWindowsGroup"
                        Value="{x:Static enums:TriState.Unknown}"
                        CheckedChanged="OnWindowsChanged" />
                    <RadioButton
                        x:Name="WindowsYesRb"
                        Content="{x:Static t:Localisation.RadioYes}"
                        GroupName="TransitWindowsGroup"
                        Value="{x:Static enums:TriState.Yes}"
                        CheckedChanged="OnWindowsChanged" />
                    <RadioButton
                        x:Name="WindowsNoRb"
                        Content="{x:Static t:Localisation.RadioNo}"
                        GroupName="TransitWindowsGroup"
                        Value="{x:Static enums:TriState.No}"
                        CheckedChanged="OnWindowsChanged" />
                </HorizontalStackLayout>

                <!-- Ventilation / A/C active? -->
                <Label Text="{x:Static t:Localisation.RadioButtonLabelVentilationSystem}"
                       Style="{StaticResource SectionLabelStyle}" />

                <HorizontalStackLayout Spacing="5">
                    <RadioButton
                        x:Name="VentilationUnknownRb"
                        Content="{x:Static t:Localisation.RadioNoData}"
                        IsChecked="True"
                        GroupName="TransitVentilationGroup"
                        Value="{x:Static enums:TriState.Unknown}"
                        CheckedChanged="OnVentilationChanged" />
                    <RadioButton
                        x:Name="VentilationYesRb"
                        Content="{x:Static t:Localisation.RadioYes}"
                        GroupName="TransitVentilationGroup"
                        Value="{x:Static enums:TriState.Yes}"
                        CheckedChanged="OnVentilationChanged" />
                    <RadioButton
                        x:Name="VentilationNoRb"
                        Content="{x:Static t:Localisation.RadioNo}"
                        GroupName="TransitVentilationGroup"
                        Value="{x:Static enums:TriState.No}"
                        CheckedChanged="OnVentilationChanged" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- Custom Note -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.RecordingCustomNoteLabelText}"
                       Style="{StaticResource SectionLabelStyle}" />
                <Editor
                    x:Name="NoteEditor"
                    Placeholder="{x:Static t:Localisation.RecordingCustomNotPlaceholderText}"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="80"
                    BackgroundColor="{AppThemeBinding Light={StaticResource InputBackground}, Dark={StaticResource InputBackgroundDark}}"
                    TextChanged="OnCustomNotesChanged" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="SubmitButton"
                Text="{x:Static t:Localisation.SubmitRecordingButton}"
                Clicked="OnSubmitRecordingClicked"
                HorizontalOptions="Fill" />

        <Button Text="{x:Static t:Localisation.CancelRecordingButton}"
                Style="{StaticResource SecondaryButtonStyle}"
                Clicked="OnCancelClicked"
                HorizontalOptions="Fill" />

    <Label x:Name="VersionLabel"
           HorizontalOptions="Center"
           FontSize="12"
           TextColor="{AppThemeBinding Light=#888888, Dark=#666666}"
           Margin="0,8,0,4" />

    </VerticalStackLayout>
    </ScrollView>

</local:AppPage>
