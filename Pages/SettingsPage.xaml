<?xml version="1.0" encoding="utf-8" ?>
<local:AppPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:IndoorCO2MapAppV2.Resources.Strings"
             xmlns:local="clr-namespace:IndoorCO2MapAppV2.Pages"
             xmlns:c="clr-namespace:IndoorCO2MapAppV2.Controls"
             x:Class="IndoorCO2MapAppV2.Pages.SettingsPage"
             Title="{x:Static t:Localisation.MainMenuSettingsButtonText}">

    <ScrollView>
    <VerticalStackLayout Padding="30" Spacing="14">

        <Button Text="{x:Static t:Localisation.CommonMainMenuButton}" Clicked="OnNavigateClicked" CommandParameter="///home" HorizontalOptions="Fill"/>

        <!--
        <Button Text="Sensor Debug" Clicked="OnNavigateClicked" CommandParameter="///sensorDebug" HorizontalOptions="Fill"/>
        <Button Text="Overpass Debug" Clicked="OnNavigateClicked" CommandParameter="///overpassDebug" HorizontalOptions="Fill"/>
        <Button Text="Building Recording Debug" Clicked="OnNavigateClicked" CommandParameter="///buildingRecordingDebug" HorizontalOptions="Fill"/>
        -->

        <!-- ===== Language ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionLanguage}" Style="{StaticResource SectionLabelStyle}" />
                <c:LabeledSegmentedControl Label="{x:Static t:Localisation.SettingsAppLanguage}"
                    Items="{Binding LanguageOptions}"
                    SelectedItem="{Binding SelectedLanguage}" />
                <Label Text="{Binding LanguageRestartHint}"
                       FontSize="12"
                       Style="{StaticResource CaptionLabelStyle}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== Sensor ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionSensorFilter}" Style="{StaticResource SectionLabelStyle}" />
                <Entry
                    Text="{Binding SensorFilter}"
                    Placeholder="{x:Static t:Localisation.SettingsSensorFilterPlaceholder}"
                    ClearButtonVisibility="WhileEditing" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsStopScanAtFirstSensor}"
                                 IsToggled="{Binding StopScanAtFirstSensor}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== Display ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionDisplay}" Style="{StaticResource SectionLabelStyle}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowSortingToggle}" IsToggled="{Binding DisplaySortingModeToggle}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowBuildingFilter}" IsToggled="{Binding DisplayBuildingFilterInputField}" />
                <c:LabeledSegmentedControl Label="{x:Static t:Localisation.SettingsDefaultSortMode}" Items="{Binding SortModes}" SelectedItem="{Binding DefaultSortMode}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowWebsiteButton}" IsToggled="{Binding ShowWebsiteButton}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowImprintButton}" IsToggled="{Binding ShowImprintButton}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowManualButton}" IsToggled="{Binding ShowManualButton}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowNewsNotification}" IsToggled="{Binding ShowNewsNotification}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowDiscordButton}" IsToggled="{Binding ShowDiscordButton}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== Transit ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.MainMenuModeTransit}" Style="{StaticResource SectionLabelStyle}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowRoutePreview}" IsToggled="{Binding ShowRoutePreview}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsShowChangeRoute}" IsToggled="{Binding ShowChangeRouteInRecording}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== Recording ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionRecording}" Style="{StaticResource SectionLabelStyle}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsConfirmBeforeSubmit}" IsToggled="{Binding ConfirmationBeforeRecordingUpload}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsAllowStartWithoutSensorData}"
                                 IsToggled="{Binding AllowStartWithoutSensorData}" />
                <!-- Android only: iOS has no equivalent foreground service. -->
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsKeepRecordingInBackground}"
                                 IsToggled="{Binding KeepRecordingInBackground}"
                                 IsVisible="{OnPlatform Default=False, Android=True}" />
            </VerticalStackLayout>
        </Border>

        <!-- ===== Data ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionData}" Style="{StaticResource SectionLabelStyle}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsUseLiveLocationService}" IsToggled="{Binding UseLiveLocationService}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsEnableLocationCaching}" IsToggled="{Binding EnableLocationCaching}" />
                <c:LabeledSegmentedControl Label="{x:Static t:Localisation.SettingsCacheRangeOverride}"
                    Items="{Binding CacheRangeOverrideOptions}"
                    SelectedItem="{Binding CacheRangeOverride}" />
                <c:LabeledSwitch Text="{x:Static t:Localisation.SettingsEnableHistory}" IsToggled="{Binding EnableHistory}" />
                <Button Text="{x:Static t:Localisation.SettingsDeleteLocationCache}"
                        Clicked="OnDeleteLocationCacheClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource ErrorColorDark}}"
                        BorderColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource ErrorColorDark}}"
                        HorizontalOptions="Fill"/>
                <Button Text="{x:Static t:Localisation.SettingsDeleteHistory}"
                        Clicked="OnDeleteRecordingHistoryClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        TextColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource ErrorColorDark}}"
                        BorderColor="{AppThemeBinding Light={StaticResource ErrorColor}, Dark={StaticResource ErrorColorDark}}"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </Border>

        <!-- ===== Debug ===== -->
        <Border Style="{StaticResource CardBorderStyle}">
            <VerticalStackLayout Spacing="10">
                <Label Text="{x:Static t:Localisation.SettingsSectionDebug}" Style="{StaticResource SectionLabelStyle}" />
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="{x:Static t:Localisation.SettingsRoundGps}"
                           Grid.Column="0"
                           VerticalOptions="Center" />
                    <Switch x:Name="RoundGpsSwitch"
                            IsToggled="True"
                            Grid.Column="1"
                            Toggled="OnRoundGpsToggled" />
                </Grid>
                <Button Text="{x:Static t:Localisation.SettingsCopyDebugLog}"
                        Clicked="OnCopyDebugLogClicked"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalOptions="Fill"/>
            </VerticalStackLayout>
        </Border>

        <Label Text="{Binding AppVersion}"
               HorizontalOptions="Center"
               FontSize="12"
               TextColor="{AppThemeBinding Light=#888888, Dark=#666666}"
               Margin="0,8,0,4" />

    </VerticalStackLayout>
    </ScrollView>

</local:AppPage>
